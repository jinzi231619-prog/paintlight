{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paintlight",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "SEARCH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "IMAGE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "CONTRIBUTION_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTRIBUTIONS",
        "class_name": "ContributionStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "community-v1",
      "new_sqlite_classes": [
        "ContributionStore"
      ]
    }
  ]
}
